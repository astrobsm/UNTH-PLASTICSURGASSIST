{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "comment": "Monday & Friday review reminder. 06:00 UTC = 07:00 West Africa Time, before the ward round. The handler re-checks the weekday in the unit's timezone and skips any other day.",
      "path": "/api/cron/duty-reminders-weekly",
      "schedule": "0 6 * * 1,5"
    },
    {
      "comment": "Daily house-officer status-update reminder, 06:30 UTC = 07:30 WAT.",
      "path": "/api/cron/duty-reminders-daily",
      "schedule": "30 6 * * *"
    }
  ],
  "rewrites": [
    {
      "comment": "Cron entry points. Separate paths rather than query strings on the cron itself, so a scheduled call can never lose its action and quietly do nothing.",
      "source": "/api/cron/duty-reminders-weekly",
      "destination": "/api/duty-reminders?action=run&kind=weekly"
    },
    {
      "source": "/api/cron/duty-reminders-daily",
      "destination": "/api/duty-reminders?action=run&kind=daily"
    },
    {
      "source": "/api/consults/:path*",
      "destination": "/api/consults"
    },
    {
      "source": "/api/consults-module/:path*",
      "destination": "/api/consults-module"
    },
    {
      "source": "/api/clinic-appointments/:path*",
      "destination": "/api/clinic-appointments"
    },
    {
      "source": "/api/pre-surgical-conference/:path*",
      "destination": "/api/pre-surgical-conference"
    },
    {
      "source": "/api/sti-protocol/:path*",
      "destination": "/api/sti-protocol"
    },
    {
      "source": "/api/pressure-sore-protocol/:path*",
      "destination": "/api/pressure-sore-protocol"
    },
    {
      "source": "/api/medical-team/:path*",
      "destination": "/api/medical-team"
    },
    {
      "source": "/api/keloid-care/:path*",
      "destination": "/api/keloid-care"
    },
    {
      "source": "/api/substance-assessments/:path*",
      "destination": "/api/substance-assessments"
    },
    {
      "source": "/api/attendance/:path*",
      "destination": "/api/attendance"
    },
    {
      "source": "/api/students/:path*",
      "destination": "/api/students"
    },
    {
      "source": "/api/mdt/:path*",
      "destination": "/api/mdt"
    },
    {
      "source": "/api/investigation-uploads/:path*",
      "destination": "/api/investigation-uploads"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|book-appointment\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, x-init-secret" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
