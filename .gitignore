# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
*.tsbuildinfo
.vercel
.env*.local
# `vercel env pull` writes real secrets to whatever filename it is given. The
# patterns above miss anything not ending in .local, so cover the rest.
.env.vercel*
.env.*.tmp
*.env.tmp

# Local admin/DB utility scripts (may contain or read credentials — keep out of VCS)
db-env.mjs
create-superadmin.mjs
reset-password.mjs

# Offline assets copied out of node_modules by scripts/prepare-offline-assets.mjs.
# Regenerated on every build and reproducible with no network, so they stay out
# of VCS. public/tesseract/eng.traineddata.gz is the exception — it is the only
# file that must be downloaded, so it IS committed to keep builds offline-safe.
public/fonts/
public/tesseract/worker.min.js
public/tesseract/tesseract-core-*.wasm.js
public/tesseract/manifest.json

# Playwright (offline e2e suite)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Regenerable audit output (11MB). Run scripts/audit-question-bank.mjs to rebuild.
audit/question-bank.json
